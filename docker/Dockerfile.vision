FROM python:3.11-slim

LABEL org.opencontainers.image.title="hexapod-vision"
LABEL org.opencontainers.image.description="STEM Hexapod MJPEG vision service"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir \
    fastapi==0.110.0 \
    "uvicorn[standard]==0.29.0" \
    opencv-python-headless==4.9.0.80 \
    numpy==1.26.4

COPY software/vision/ ./vision/

EXPOSE 8001

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/')"

CMD ["uvicorn", "vision.main:app", "--host", "0.0.0.0", "--port", "8001"]
